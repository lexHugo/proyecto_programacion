@model proyecto_programacion.Models.Activo

@{
    ViewData["Title"] = "Editar Activo";
}

<h1>@ViewData["Title"]</h1>

<h4>@Model.nom_act</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Editar">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="activo_id" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="nom_act" class="control-label"></label>
                        <input asp-for="nom_act" class="form-control" />
                        <span asp-validation-for="nom_act" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="cod_act" class="control-label"></label>
                        <input asp-for="cod_act" class="form-control" />
                        <span asp-validation-for="cod_act" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                     <div class="form-group mb-3">
                        <label asp-for="categ_id" class="control-label"></label>
                        <select asp-for="categ_id" class="form-control" asp-items="ViewBag.categ_id"></select>
                        <span asp-validation-for="categ_id" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="ubic_id" class="control-label"></label>
                        <select asp-for="ubic_id" class="form-control" asp-items="ViewBag.ubic_id"></select>
                         <span asp-validation-for="ubic_id" class="text-danger"></span>
                    </div>
                </div>
            </div>

             <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="modelo" class="control-label"></label>
                        <input asp-for="modelo" class="form-control" />
                    </div>
                </div>
                 <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="num_serie" class="control-label"></label>
                        <input asp-for="num_serie" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="costo" class="control-label"></label>
                        <input asp-for="costo" class="form-control" />
                        <span asp-validation-for="costo" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="fecha_com" class="control-label"></label>
                        <input asp-for="fecha_com" class="form-control" />
                        <span asp-validation-for="fecha_com" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="proveedor" class="control-label"></label>
                        <input asp-for="proveedor" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="estado" class="control-label"></label>
                        <input asp-for="estado" class="form-control" />
                         <span asp-validation-for="estado" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
            </div>
        </form>
    </div>
</div>
