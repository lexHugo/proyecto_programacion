@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ActivoSys</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-shield-alt logo-icon"></i>
            <h3 class="logo-text">ActivoSys</h3>
        </div>
        <nav class="sidebar-nav">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-tachometer-alt"></i><span>Dashboard</span></a>
                </li>
                
                <li class="nav-title">INVENTARIO</li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Activos" asp-action="Index"><i class="fas fa-box"></i><span>Inventario de Activos</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Gestion" asp-action="Categorias"><i class="fas fa-tags"></i><span>Gestión de Categorías</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Gestion" asp-action="Ubicaciones"><i class="fas fa-map-marker-alt"></i><span>Gestión de Ubicaciones</span></a>
                </li>
                
                @if (SignInManager.IsSignedIn(User) && User.IsInRole("Administrador"))
                {
                    <li class="nav-title">ADMINISTRACIÓN</li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Index">
                            <i class="fas fa-users-cog"></i><span>Gestión de Usuarios</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </aside>

    <!-- Área de Contenido Principal -->
    <main class="main-content">
        <!-- CABECERA DE PÁGINA PROFESIONAL -->
        <header class="page-header">
            <h1 class="page-title">@ViewData["Title"]</h1>
            
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="user-menu dropdown">
                    <button class="btn btn-light dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="user-avatar">@UserManager.GetUserName(User).Substring(0, 1).ToUpper()</span>
                        @UserManager.GetUserName(User)
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><h6 class="dropdown-header">@UserManager.GetUserName(User)</h6></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
        </header>

        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

