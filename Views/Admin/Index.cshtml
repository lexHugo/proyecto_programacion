@model IEnumerable<proyecto_programacion.Models.Usuario>

@{
    ViewData["Title"] = "Administración de Usuarios";
}

<!-- Contenedor para las notificaciones (Toasts) -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast show align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">@ViewData["Title"]</h4>
        <a class="btn btn-primary" asp-action="CrearUsuario">
            <i class="fas fa-plus-circle me-2"></i>Crear Nuevo Usuario
        </a>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center p-4">
                <p class="text-muted">No hay usuarios registrados.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Nombre Completo</th>
                            <th>Email / Usuario</th>
                            <th>Edad</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td><strong>@user.NombreCompleto</strong></td>
                                <td>@user.Email</td>
                                <td>
                                    @{
                                        var today = DateTime.Today;
                                        var age = today.Year - user.FechaNacimiento.Year;
                                        if (user.FechaNacimiento.Date > today.AddYears(-age)) age--;
                                    }
                                    @age años
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-primary btn-sm" asp-action="GestionarRoles" asp-route-userId="@user.Id">
                                        <i class="fas fa-user-shield me-2"></i>Gestionar Roles
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Script para ocultar notificaciones después de 5 segundos
        document.addEventListener('DOMContentLoaded', function () {
            var toastElList = [].slice.call(document.querySelectorAll('.toast.show'));
            var toastList = toastElList.map(function (toastEl) {
                var toast = new bootstrap.Toast(toastEl, { delay: 5000 });
                toast.show();
            });
        });
    </script>
}

